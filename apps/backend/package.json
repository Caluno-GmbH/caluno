{
  "name": "caluno-backend",
  "version": "1.0.0",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build && cp -r src/database/migrations dist/src/database/ && (test -d src/ee/migrations && mkdir -p dist/src/ee && cp -r src/ee/migrations dist/src/ee/migrations || true) && (test -f src/ee/drizzle.config.ts && mkdir -p dist/src/ee && cp src/ee/drizzle.config.ts dist/src/ee/ || true) && cp -r src/i18n/locales dist/src/i18n/",
    "dev": "bun nest start --watch",
    "start": "bun nest start",
    "start:debug": "bun nest start --debug --watch",
    "start:prod": "bun dist/src/main.js",
    "check-types": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome format --write",
    "format-and-lint": "biome check",
    "format-and-lint:fix": "biome check --write",
    "test": "bun test src",
    "test:watch": "bun test src --watch",
    "test:cov": "bun test src --coverage",
    "test:debug": "bun test src",
    "test:e2e": "bun test test/",
    "test:integration:setup": "bun run test/setup-test-db.ts",
    "test:integration": "bun test test/",
    "db:generate": "bun run db:generate:oss && bun run db:generate:ee",
    "db:generate:oss": "drizzle-kit generate",
    "db:generate:ee": "test ! -f src/ee/drizzle.config.ts || ! find src/ee -path '*/schemas/*.ts' -print -quit | grep -q . || drizzle-kit generate --config=src/ee/drizzle.config.ts",
    "db:migrate": "bun run src/database/migrate.mts",
    "db:migrate:oss": "drizzle-kit migrate",
    "db:migrate:ee": "test ! -f src/ee/drizzle.config.ts || drizzle-kit migrate --config=src/ee/drizzle.config.ts",
    "db:ee": "test ! -f src/ee/drizzle.config.ts || drizzle-kit --config=src/ee/drizzle.config.ts",
    "db:seed": "bun run src/database/seed.ts",
    "db:fixtures:e2e": "bun run src/database/fixtures.ts",
    "db:fixtures:demo": "bun run src/database/demo-fixtures.ts",
    "db:studio": "drizzle-kit studio",
    "terms:publish": "bun run src/terms/publish-terms.cli.ts"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@aws-sdk/client-s3": "^3.1166.0",
    "@aws-sdk/s3-request-presigner": "^3.1166.0",
    "@better-auth/drizzle-adapter": "1.7.18",
    "@messageformat/core": "^3.4.1",
    "@nestjs/apollo": "^14.2.0",
    "@nestjs/common": "^12.4.2",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.4.2",
    "@nestjs/event-emitter": "^12.0.2",
    "@nestjs/graphql": "^14.2.0",
    "@nestjs/platform-express": "^12.4.2",
    "@nestjs/schedule": "^12.0.3",
    "@nestjs/terminus": "^12.1.0",
    "@repo/lifespan": "*",
    "@repo/observability": "*",
    "@repo/password-policy": "*",
    "@sentry/nestjs": "^11.12.0",
    "@thallesp/nestjs-better-auth": "^2.8.0",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-de": "^4.1.1",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "adm-zip": "^0.6.1",
    "better-auth": "1.7.18",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dataloader": "^2.2.3",
    "drizzle-kit": "1.0.0-rc.5",
    "drizzle-orm": "1.0.0-rc.5",
    "express": "^5.3.0",
    "graphql": "^16.14.2",
    "graphql-scalars": "^2.0.1",
    "mjml": "^5.4.1",
    "nanoid": "^6.0.2",
    "nestjs-i18n": "^10.8.5",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "^10.3.1",
    "pdf-lib": "1.17.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "posthog-node": "^5.61.2",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rrule": "^2.8.1",
    "rxjs": "^7.8.2",
    "short-unique-id": "^5.3.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.12",
    "@nestjs/schematics": "^12.0.13",
    "@nestjs/testing": "^12.4.2",
    "@repo/typescript-config": "*",
    "@sentry/cli": "^3.8.2",
    "@types/adm-zip": "^0.6.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/mjml": "^5.4.2",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "pino-pretty": "^13.2.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": {
            "rootDir": "src"
          }
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "transformIgnorePatterns": [
      "node_modules/(?!(nanoid)/)"
    ]
  }
}
